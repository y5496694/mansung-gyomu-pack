  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-concurrency=1 tests/*.test.cjs",
    "package": "node scripts/package.cjs",
    "cli": "node src/cli.cjs",
    "relay:kakao": "node src/kakao-relay.cjs",
    "guide:build": "node scripts/write-user-guide.cjs",
    "guide:check": "node scripts/write-user-guide.cjs --check",
    "start:talk": "electron . --talk",
    "cli:talk": "node src/talk-cli.cjs",
    "test:talk:desktop": "node tests/talk-desktop.cjs"
  },
  "devDependencies": {
    "electron": "44.9.1",
    "playwright-core": "1.64.1"
  },
  "bin": {
    "narae-office": "src/cli.cjs",
    "narae-talk": "src/talk-cli.cjs"
  }
}
